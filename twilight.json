{
  "version": "1.0.0",
  "theme_name": "لمح | Lamh",
  "repo_url": "https://github.com/authaymeen/theme-lamh",
  "support_url": "mailto:admin@automataiqksa.com",

  "settings": [
    {
      "type": "boolean",
      "icon": "sicon-toggle-off",
      "id": "sticky_header",
      "label": "تثبيت الهيدر عند التمرير",
      "format": "switch",
      "required": false,
      "value": true,
      "selected": true
    },
    {
      "type": "boolean",
      "icon": "sicon-toggle-off",
      "id": "topnav_is_dark",
      "label": "شريط علوي داكن",
      "format": "switch",
      "required": false,
      "value": false,
      "selected": false
    },
    {
      "type": "boolean",
      "icon": "sicon-toggle-off",
      "id": "footer_is_dark",
      "label": "فوتر داكن",
      "format": "switch",
      "required": false,
      "value": true,
      "selected": true
    },
    {
      "type": "boolean",
      "icon": "sicon-toggle-off",
      "id": "show_breadcrumb",
      "label": "إظهار مسار التصفح (Breadcrumb)",
      "format": "switch",
      "required": false,
      "value": true,
      "selected": true
    },
    {
      "type": "boolean",
      "icon": "sicon-toggle-off",
      "id": "show_quick_add",
      "label": "زر إضافة سريعة للسلة داخل شبكة المنتجات",
      "format": "switch",
      "required": false,
      "value": true,
      "selected": true
    },
    {
      "type": "boolean",
      "icon": "sicon-toggle-off",
      "id": "show_ratings",
      "label": "إظهار تقييمات المنتج",
      "format": "switch",
      "required": false,
      "value": true,
      "selected": true
    }
  ],

  "features": [
    "filters",
    "component-featured-products",
    "component-products-slider",
    "component-photos-slider",
    "component-testimonials",
    "component-random-testimonials",
    "component-store-features",
    "component-square-photos",
    "component-fixed-banner",
    "component-youtube"
  ],

  "components": [
    {
      "name": "hero-banner",
      "title": "بانر رئيسي (لمح)",
      "icon": "sicon-image-carousel",
      "path": "home.hero-banner",
      "fields": [
        {
          "id": "slides",
          "type": "collection",
          "format": "collection",
          "label": "الشرائح",
          "required": true,
          "minLength": 1,
          "maxLength": 5,
          "fields": [
            { "id": "image", "type": "string", "format": "image", "label": "صورة الشريحة (يفضّل 1920×800)", "required": true },
            { "id": "title", "type": "string", "label": "العنوان", "required": false },
            { "id": "subtitle", "type": "string", "label": "العنوان الفرعي", "required": false },
            { "id": "button_text", "type": "string", "label": "نص الزر", "required": false },
            { "id": "button_link", "type": "string", "format": "url", "label": "رابط الزر", "required": false }
          ]
        }
      ]
    },
    {
      "name": "categories-grid",
      "title": "شبكة تصنيفات (لمح)",
      "icon": "sicon-grid",
      "path": "home.categories-grid",
      "fields": [
        { "id": "title", "type": "string", "label": "عنوان القسم", "required": false, "value": "تسوّق حسب التصنيف" },
        {
          "id": "categories",
          "type": "collection",
          "format": "collection",
          "label": "التصنيفات",
          "required": true,
          "minLength": 2,
          "maxLength": 8,
          "fields": [
            { "id": "image", "type": "string", "format": "image", "label": "صورة التصنيف (مربّعة)", "required": true },
            { "id": "title", "type": "string", "label": "اسم التصنيف", "required": true },
            { "id": "link", "type": "string", "format": "url", "label": "رابط التصنيف", "required": true }
          ]
        }
      ]
    },
    {
      "name": "value-props",
      "title": "مزايا المتجر (لمح)",
      "icon": "sicon-badge-discount",
      "path": "home.value-props",
      "fields": [
        {
          "id": "items",
          "type": "collection",
          "format": "collection",
          "label": "المزايا",
          "required": true,
          "minLength": 2,
          "maxLength": 4,
          "fields": [
            { "id": "icon", "type": "string", "label": "اسم أيقونة سلة (مثال: sicon-shipping-fast)", "required": true },
            { "id": "title", "type": "string", "label": "العنوان", "required": true },
            { "id": "text", "type": "string", "format": "textarea", "label": "وصف مختصر", "required": false }
          ]
        }
      ]
    },
    {
      "name": "featured-collection",
      "title": "تشكيلة مختارة (لمح)",
      "icon": "sicon-shopping-bag",
      "path": "home.featured-collection",
      "fields": [
        { "id": "title", "type": "string", "label": "عنوان القسم", "required": true, "value": "تشكيلة مختارة لك" },
        { "id": "subtitle", "type": "string", "label": "عنوان فرعي", "required": false }
      ]
    }
  ]
}
