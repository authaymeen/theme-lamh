{% extends 'layouts/master' %}

{% block title %}{{ trans('common.brands')|default('الماركات') }}{% endblock %}

{% block content %}
<div class="max-w-container mx-auto px-4 py-10">
    <h1 class="text-2xl font-bold text-neutral-900 mb-8">{{ trans('common.brands')|default('الماركات التجارية') }}</h1>

    {% if brands|default([])|length %}
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4">
            {% for brand in brands %}
                <a href="{{ brand.url }}" class="brand-card flex items-center justify-center border border-neutral-100 rounded-card p-6 aspect-square hover:border-accent hover:shadow-card transition-all">
                    <img src="{{ brand.logo }}" alt="{{ brand.name }}" loading="lazy" class="max-h-16 w-auto object-contain grayscale hover:grayscale-0 transition-all">
                </a>
            {% endfor %}
        </div>
    {% else %}
        {% include 'pages/partials/empty-state' with {icon: 'sicon-tag', title: trans('brands.no_brands')|default('لا توجد ماركات مضافة بعد')} %}
    {% endif %}
</div>
{% endblock %}

{% block script %}
    <script src="{{ 'brands.js'|asset }}" defer></script>
{% endblock %}
