{% extends 'layouts/master' %}

{% block title %}{{ trans('customer.notifications')|default('الإشعارات') }}{% endblock %}

{% block content %}
<div class="max-w-container mx-auto px-4 py-10">
    <div class="grid grid-cols-1 lg:grid-cols-[240px_1fr] gap-8">
        {% include 'pages/customer/partials/sidebar' with {active: 'notifications'} %}

        <div>
            <h1 class="text-xl font-bold text-neutral-900 mb-6">{{ trans('customer.notifications')|default('الإشعارات') }}</h1>

            {% if notifications|default([])|length %}
                <div class="divide-y divide-neutral-100 border border-neutral-100 rounded-card overflow-hidden">
                    {% for notification in notifications %}
                        <div class="flex items-start gap-3 p-4 {% if not notification.read %}bg-accent-light/40{% endif %}">
                            <span class="w-9 h-9 rounded-full bg-accent-light text-accent flex items-center justify-center shrink-0">
                                <i class="sicon-bell text-sm" aria-hidden="true"></i>
                            </span>
                            <div>
                                <p class="text-sm text-neutral-800">{{ notification.message }}</p>
                                <p class="text-xs text-neutral-400 mt-1">{{ notification.date|time_ago }}</p>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% else %}
                {% include 'pages/partials/empty-state' with {icon: 'sicon-bell', title: trans('customer.no_notifications')|default('لا توجد إشعارات حاليًا')} %}
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
