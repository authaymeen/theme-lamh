{% extends 'layouts/master' %}

{% block title %}{{ trans('common.cart')|default('سلة المشتريات') }}{% endblock %}

{% block content %}
<div class="max-w-container mx-auto px-4 py-8">
    <h1 class="text-2xl font-extrabold text-neutral-900 mb-8">{{ trans('common.cart')|default('سلة المشتريات') }}</h1>

    {% if cart.items|default([])|length %}
    <div class="grid grid-cols-1 lg:grid-cols-[1fr_360px] gap-8 items-start">

        <div class="cart-items bg-white divide-y divide-neutral-100 rounded-card shadow-card overflow-hidden">
            {% for item in cart.items %}
                <div class="cart-item flex items-center gap-4 p-4" data-item-id="{{ item.id }}">
                    <a href="{{ item.product.url }}" class="shrink-0 w-20 h-20 rounded-lg overflow-hidden bg-neutral-50">
                        <img src="{{ item.product.image }}" alt="{{ item.product.name }}" class="w-full h-full object-cover">
                    </a>
                    <div class="flex-1 min-w-0">
                        <a href="{{ item.product.url }}" class="font-semibold text-sm text-neutral-900 line-clamp-1 hover:text-accent">{{ item.product.name }}</a>
                        {% if item.options|default([])|length %}
                            <p class="text-xs text-neutral-400 mt-1">
                                {% for option in item.options %}{{ option.name }}: {{ option.value }}{% if not loop.last %} · {% endif %}{% endfor %}
                            </p>
                        {% endif %}
                        <div class="flex items-center gap-3 mt-2">
                            <div class="quantity-input flex items-center border border-neutral-200 rounded-card overflow-hidden">
                                <button type="button" class="w-8 h-8 flex items-center justify-center text-neutral-500" data-action="decrease" data-item-id="{{ item.id }}">−</button>
                                <span class="w-8 text-center text-sm">{{ item.quantity }}</span>
                                <button type="button" class="w-8 h-8 flex items-center justify-center text-neutral-500" data-action="increase" data-item-id="{{ item.id }}">+</button>
                            </div>
                            <button type="button" class="text-xs text-neutral-400 hover:text-red-500" data-action="remove-item" data-item-id="{{ item.id }}">
                                {{ trans('cart.remove')|default('إزالة') }}
                            </button>
                        </div>
                    </div>
                    <div class="text-sm font-bold text-neutral-900 shrink-0">{{ item.total|currency }}</div>
                </div>
            {% endfor %}
        </div>

        <aside class="order-summary bg-white rounded-card shadow-card p-6 sticky top-24">
            <h2 class="font-extrabold text-neutral-900 mb-4">{{ trans('cart.order_summary')|default('ملخص الطلب') }}</h2>

            <div class="space-y-2.5 text-sm">
                <div class="flex justify-between text-neutral-500">
                    <span>{{ trans('cart.subtotal')|default('المجموع الفرعي') }}</span>
                    <span>{{ cart.sub_total|currency }}</span>
                </div>
                {% if cart.discount|default(0) > 0 %}
                <div class="flex justify-between text-accent">
                    <span>{{ trans('cart.discount')|default('الخصم') }}</span>
                    <span>-{{ cart.discount|currency }}</span>
                </div>
                {% endif %}
                <div class="flex justify-between text-neutral-500">
                    <span>{{ trans('cart.shipping')|default('الشحن') }}</span>
                    <span>{{ trans('cart.calculated_at_checkout')|default('يُحتسب عند الدفع') }}</span>
                </div>
            </div>

            <form class="coupon-form flex mt-4" data-component="coupon-form">
                <input type="text" name="coupon" placeholder="{{ trans('cart.coupon_code')|default('كود الخصم') }}"
                       class="flex-1 rounded-s-card border-neutral-200 text-sm focus:border-accent focus:ring-accent">
                <button type="submit" class="bg-neutral-900 text-white text-sm px-4 rounded-e-card">{{ trans('common.apply')|default('تطبيق') }}</button>
            </form>

            <div class="flex justify-between font-bold text-neutral-900 border-t border-neutral-100 mt-4 pt-4">
                <span>{{ trans('cart.total')|default('الإجمالي') }}</span>
                <span>{{ cart.total|currency }}</span>
            </div>

            <a href="{{ page('checkout') }}" class="checkout-btn block text-center bg-accent hover:bg-accent-dark text-white rounded-card py-3.5 font-bold mt-5 transition-colors">
                {{ trans('cart.checkout')|default('إتمام الطلب') }}
            </a>
        </aside>
    </div>
    {% else %}
        {% include 'pages/partials/empty-state' with {
            icon: 'sicon-shopping-bag',
            title: trans('cart.empty_cart')|default('سلتك فارغة'),
            text: trans('cart.start_shopping')|default('تصفّح منتجاتنا وأضف ما يعجبك')
        } %}
        <div class="flex justify-center mt-4">
            <a href="{{ link('/') }}" class="bg-accent hover:bg-accent-dark text-white rounded-card px-6 py-3 text-sm font-bold">
                {{ trans('cart.browse_products')|default('تصفح المنتجات') }}
            </a>
        </div>
    {% endif %}
</div>
{% endblock %}

{% block script %}
    <script src="{{ 'cart.js'|asset }}" defer></script>
{% endblock %}
