{% extends 'layouts/master' %}

{% block title %}{{ trans('loyalty.program')|default('برنامج الولاء') }}{% endblock %}

{% block content %}
<div class="max-w-container mx-auto px-4 py-12">
    <div class="text-center max-w-xl mx-auto mb-12">
        <h1 class="text-2xl sm:text-3xl font-bold text-neutral-900 mb-3">{{ trans('loyalty.program')|default('برنامج الولاء') }}</h1>
        <p class="text-neutral-500">{{ trans('loyalty.description')|default('اجمع نقاطًا مع كل عملية شراء واستبدلها بمكافآت حصرية.') }}</p>
    </div>

    {% if customer.authenticated %}
        <div class="loyalty-card bg-gradient-to-br from-accent to-accent-dark text-white rounded-card p-8 max-w-md mx-auto text-center mb-12">
            <p class="text-sm opacity-80 mb-1">{{ trans('loyalty.your_points')|default('رصيدك الحالي') }}</p>
            <p class="text-4xl font-bold">{{ loyalty.points|default(0) }}</p>
            <p class="text-sm opacity-80 mt-1">{{ trans('loyalty.point')|default('نقطة') }}</p>
        </div>
    {% endif %}

    {% if loyalty.tiers|default([])|length %}
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
        {% for tier in loyalty.tiers %}
            <div class="border border-neutral-100 rounded-card p-6 text-center">
                <h3 class="font-bold text-neutral-900 mb-2">{{ tier.name }}</h3>
                <p class="text-sm text-neutral-500">{{ tier.description }}</p>
            </div>
        {% endfor %}
    </div>
    {% endif %}
</div>
{% endblock %}

{% block script %}
    <script src="{{ 'loyalty.js'|asset }}" defer></script>
{% endblock %}
