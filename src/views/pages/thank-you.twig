{% extends 'layouts/master' %}

{% block title %}{{ trans('order.thank_you')|default('شكرًا لطلبك') }}{% endblock %}

{% block content %}
<div class="max-w-2xl mx-auto px-4 py-16 text-center">
    <span class="w-20 h-20 rounded-full bg-accent-light text-accent flex items-center justify-center mx-auto mb-6">
        <i class="sicon-check-circle text-4xl" aria-hidden="true"></i>
    </span>

    <h1 class="text-2xl sm:text-3xl font-bold text-neutral-900 mb-3">{{ trans('order.thank_you')|default('شكرًا لك، تم استلام طلبك!') }}</h1>
    <p class="text-neutral-500 mb-8">
        {{ trans('order.confirmation_sent')|default('أرسلنا تفاصيل الطلب إلى بريدك الإلكتروني وسنُعلمك بكل تحديث.') }}
    </p>

    <div class="order-summary-card border border-neutral-100 rounded-card p-6 text-start mb-8">
        <div class="flex justify-between text-sm mb-2">
            <span class="text-neutral-500">{{ trans('order.order_number')|default('رقم الطلب') }}</span>
            <span class="font-semibold text-neutral-900">#{{ order.id|default('—') }}</span>
        </div>
        <div class="flex justify-between text-sm mb-2">
            <span class="text-neutral-500">{{ trans('cart.total')|default('الإجمالي') }}</span>
            <span class="font-semibold text-neutral-900">{{ order.total|default(0)|currency }}</span>
        </div>
        <div class="flex justify-between text-sm">
            <span class="text-neutral-500">{{ trans('order.payment_method')|default('طريقة الدفع') }}</span>
            <span class="font-semibold text-neutral-900">{{ order.payment_method|default('—') }}</span>
        </div>
    </div>

    <div class="flex items-center justify-center gap-3">
        <a href="{{ page('customer.orders.single', {id: order.id}) }}" class="border border-neutral-200 hover:border-accent hover:text-accent rounded-pill px-6 py-3 text-sm font-semibold transition-colors">
            {{ trans('order.track_order')|default('تتبّع الطلب') }}
        </a>
        <a href="{{ link('/') }}" class="bg-accent hover:bg-accent-dark text-white rounded-pill px-6 py-3 text-sm font-semibold transition-colors">
            {{ trans('common.continue_shopping')|default('متابعة التسوق') }}
        </a>
    </div>
</div>
{% endblock %}

{% block script %}
    <script src="{{ 'thankyou.js'|asset }}" defer></script>
{% endblock %}
