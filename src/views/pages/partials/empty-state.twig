{# props: icon, title, text #}
<div class="empty-state flex flex-col items-center justify-center text-center py-20 px-4">
    <span class="w-16 h-16 rounded-full bg-accent-light text-accent flex items-center justify-center mb-4">
        <i class="{{ icon|default('sicon-info-circle') }} text-2xl" aria-hidden="true"></i>
    </span>
    <h3 class="font-semibold text-neutral-900 mb-1">{{ title }}</h3>
    {% if text %}<p class="text-sm text-neutral-500 max-w-sm">{{ text }}</p>{% endif %}
</div>
