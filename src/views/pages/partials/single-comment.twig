{# props: comment #}
<div class="single-comment border border-neutral-100 rounded-card p-5">
    <div class="flex items-center justify-between mb-2">
        <div class="flex items-center gap-3">
            <span class="w-9 h-9 rounded-full bg-accent-light text-accent flex items-center justify-center font-semibold text-sm">
                {{ comment.author|default('')|slice(0, 1) }}
            </span>
            <div>
                <p class="text-sm font-semibold text-neutral-900">{{ comment.author|default(trans('common.anonymous')|default('عميل')) }}</p>
                <p class="text-xs text-neutral-400">{{ comment.date|date }}</p>
            </div>
        </div>
        {% if comment.rating %}<salla-rating rating="{{ comment.rating }}" read-only small></salla-rating>{% endif %}
    </div>
    <p class="text-sm text-neutral-600 leading-relaxed mt-2">{{ comment.content }}</p>
</div>
