{% extends 'layouts/master' %}

{% block title %}{{ trans('common.blog')|default('المدونة') }}{% endblock %}

{% block content %}
<div class="max-w-container mx-auto px-4 py-10">
    <h1 class="text-2xl font-bold text-neutral-900 mb-8">{{ trans('common.blog')|default('المدونة') }}</h1>

    {% if articles|default([])|length %}
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            {% for article in articles %}
                <a href="{{ article.url }}" class="blog-card group block border border-neutral-100 rounded-card overflow-hidden hover:shadow-card-hover transition-shadow">
                    {% if article.image %}
                        <div class="aspect-video overflow-hidden bg-neutral-50">
                            <img src="{{ article.image }}" alt="{{ article.title }}" loading="lazy"
                                 class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105">
                        </div>
                    {% endif %}
                    <div class="p-5">
                        <p class="text-xs text-neutral-400 mb-2">{{ article.date|date }}</p>
                        <h2 class="font-semibold text-neutral-900 line-clamp-2 group-hover:text-accent transition-colors">{{ article.title }}</h2>
                        {% if article.excerpt %}<p class="text-sm text-neutral-500 line-clamp-2 mt-2">{{ article.excerpt }}</p>{% endif %}
                    </div>
                </a>
            {% endfor %}
        </div>
        {% if pagination is defined %}
            <div class="mt-10 flex justify-center">{{ pagination }}</div>
        {% endif %}
    {% else %}
        {% include 'pages/partials/empty-state' with {
            icon: 'sicon-newspaper',
            title: trans('blog.no_articles')|default('لا توجد مقالات بعد')
        } %}
    {% endif %}
</div>
{% endblock %}

{% block script %}
    <script src="{{ 'blog.js'|asset }}" defer></script>
{% endblock %}
