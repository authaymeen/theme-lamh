{% extends 'layouts/master' %}

{% block title %}{{ store.name }}{% endblock %}

{% block content %}
    {#
      الصفحة الرئيسية لثيم لمح: مكوّناتنا المخصّصة أولًا (بانر رئيسي، مزايا، تصنيفات، تشكيلة مختارة)
      ثم {% component home %} لعرض أي Theme Features إضافية يفعّلها التاجر من بوابة الشركاء
      (سلايدر صور، سلايدر منتجات، آراء عملاء...) بدون الحاجة لتعديل هذا الملف.
    #}
    {% include 'components/home/hero-banner' %}
    {% include 'components/home/value-props' %}
    {% include 'components/home/categories-grid' %}
    {% include 'components/home/promo-banner' %}
    {% include 'components/home/featured-collection' %}
