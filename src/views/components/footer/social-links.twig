{% if store.social|default([])|length %}
<ul class="social-links flex items-center gap-2.5 mt-4">
    {% for social in store.social %}
        <li>
            <a href="{{ social.url }}" target="_blank" rel="noopener" aria-label="{{ social.name }}"
               class="text-accent">
                <i class="sicon-{{ social.name|lower }}" aria-hidden="true"></i>
            </a>
        </li>
    {% endfor %}
</ul>
{% endif %}
