{% set grid = component('home.categories-grid') %}
{% if grid and grid.categories|default([])|length %}
<section class="categories-grid" aria-label="{{ grid.title|default('التصنيفات') }}">
    <div class="max-w-container mx-auto px-4 py-12">
        {% if grid.title %}
            <div class="flex items-end justify-between mb-6">
                <h2 class="text-xl sm:text-2xl font-bold text-neutral-900">{{ grid.title }}</h2>
            </div>
        {% endif %}
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-{{ grid.categories|length > 6 ? '4' : grid.categories|length }} gap-4">
            {% for cat in grid.categories %}
                <a href="{{ cat.link }}" class="category-card group relative block rounded-card overflow-hidden aspect-square bg-neutral-100">
                    <img src="{{ cat.image }}" alt="{{ cat.title }}" loading="lazy"
                         class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105">
                    <span class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></span>
                    <span class="absolute bottom-4 start-4 text-white font-semibold">{{ cat.title }}</span>
                </a>
            {% endfor %}
        </div>
    </div>
</section>
{% endif %}
