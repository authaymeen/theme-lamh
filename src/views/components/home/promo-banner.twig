{#
  بانر ترويجي عريض — مساحة إعلانية واحدة كبيرة لعرض/تخفيض/تشكيلة جديدة
  props (من twilight.json): image, eyebrow, title, button_text, link
#}
{% set banner = component('home.promo-banner') %}
{% if banner and banner.image %}
<section class="promo-banner-section home-section" aria-label="{{ banner.title|default('عرض ترويجي') }}">
    <div class="max-w-container mx-auto px-4">
        <a href="{{ banner.link|default('#') }}" class="promo-banner block relative rounded-card-xl overflow-hidden">
            <img src="{{ banner.image }}" alt="{{ banner.title|default(store.name) }}" loading="lazy"
                 class="w-full h-[240px] sm:h-[320px] lg:h-[400px] object-cover">

            {% if banner.eyebrow or banner.title or banner.button_text %}
            <div class="promo-banner-overlay absolute inset-0 flex items-center">
                <div class="px-8 sm:px-12 max-w-lg text-white">
                    {% if banner.eyebrow %}
                        <p class="section-eyebrow !text-white !bg-white/15 backdrop-blur-sm">{{ banner.eyebrow }}</p>
                    {% endif %}
                    {% if banner.title %}
                        <h2 class="text-2xl sm:text-3xl font-extrabold mb-5">{{ banner.title }}</h2>
                    {% endif %}
                    {% if banner.button_text %}
                        <span class="btn inline-flex items-center gap-2 bg-white text-neutral-900 rounded-card px-6 py-2.5 text-sm font-bold hover:bg-accent hover:text-white transition-colors">
                            {{ banner.button_text }}
                            <i class="sicon-arrow-left rtl:rotate-180" aria-hidden="true"></i>
                        </span>
                    {% endif %}
                </div>
            </div>
            {% endif %}
        </a>
    </div>
</section>
{% endif %}
