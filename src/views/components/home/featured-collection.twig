{% set featured = component('home.featured-collection') %}
{% set products = latest_products|default([]) %}

{% if featured and products|length %}
<section class="featured-collection home-section is-alt" aria-label="{{ featured.title }}">
    <div class="max-w-container mx-auto px-4">
        <div class="flex items-end justify-between mb-8">
            <div>
                <p class="section-eyebrow">{{ trans('home.featured_eyebrow')|default('مختارات الأسبوع') }}</p>
                <h2 class="section-heading text-neutral-900">{{ featured.title }}</h2>
                {% if featured.subtitle %}<p class="text-neutral-500 text-sm mt-1">{{ featured.subtitle }}</p>{% endif %}
            </div>
            <a href="{{ page('product.index') }}" class="view-all-link hidden sm:inline-flex items-center justify-center w-11 h-11 shrink-0 rounded-card bg-white shadow-card text-neutral-900 hover:bg-accent hover:text-white transition-colors"
               aria-label="{{ trans('common.view_all')|default('عرض الكل') }}">
                <i class="sicon-arrow-left rtl:rotate-180" aria-hidden="true"></i>
            </a>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4 sm:gap-6">
            {% for product in products|slice(0, 8) %}
                {% include 'pages/partials/product/card' with {product: product} %}
            {% endfor %}
        </div>
    </div>
</section>
{% endif %}
