{# props: items #}
<div class="breadcrumb border-b border-neutral-100 bg-neutral-50/60">
    <nav class="max-w-container mx-auto px-4 py-3 text-xs text-neutral-500" aria-label="{{ trans('common.breadcrumb')|default('مسار التصفح') }}">
        <ol class="flex items-center flex-wrap gap-1.5">
            <li><a href="{{ link('/') }}" class="hover:text-accent">{{ trans('common.home')|default('الرئيسية') }}</a></li>
            {% for item in items %}
                <li class="flex items-center gap-1.5">
                    <i class="sicon-chevron-left rtl:rotate-180 text-[10px]" aria-hidden="true"></i>
                    {% if not loop.last %}
                        <a href="{{ item.url }}" class="hover:text-accent">{{ item.title }}</a>
                    {% else %}
                        <span class="text-neutral-800" aria-current="page">{{ item.title }}</span>
                    {% endif %}
                </li>
            {% endfor %}
        </ol>
    </nav>
</div>
