{# معرض صور المنتج: صورة رئيسية + مصغّرات، يدعم التكبير (lightbox) #}
<div class="product-gallery">
    <div class="main-image relative rounded-card overflow-hidden bg-neutral-50 aspect-square mb-3">
        <a href="{{ product.image.url|default(product.image) }}" data-fslightbox="product-gallery" data-type="image">
            <img id="main-product-image" src="{{ product.image.url|default(product.image) }}" alt="{{ product.name }}"
                 class="w-full h-full {{ theme.settings.get('product_image_fit')|default('cover') == 'contain' ? 'object-contain p-6' : 'object-cover' }}">
        </a>

        {% if product.sale_price and product.sale_price < product.price %}
            <span class="absolute top-4 start-4 bg-accent text-white text-xs font-semibold px-3 py-1.5 rounded-pill">
                {{ trans('product.discount')|default('خصم') }} {{ (((product.price - product.sale_price) / product.price) * 100)|round }}%
            </span>
        {% endif %}

        <button type="button" class="wishlist-toggle absolute top-4 end-4 w-9 h-9 rounded-full bg-white/90 flex items-center justify-center text-neutral-500 hover:text-accent"
                data-product-id="{{ product.id }}" aria-label="{{ trans('common.add_to_wishlist')|default('أضف للمفضلة') }}">
            <i class="sicon-heart" aria-hidden="true"></i>
        </button>
    </div>

    {% if product.images|default([])|length > 1 %}
        <div class="thumbnails grid grid-cols-5 gap-2.5">
            {% for image in product.images %}
                <a href="{{ image.url }}" data-fslightbox="product-gallery" data-type="image"
                   class="thumb-item aspect-square rounded-lg overflow-hidden border border-neutral-100 hover:border-accent transition-colors {% if loop.first %}border-accent{% endif %}"
                   data-main-image="{{ image.url }}">
                    <img src="{{ image.thumbnail|default(image.url) }}" alt="{{ product.name }} {{ loop.index }}" loading="lazy" class="w-full h-full object-cover">
                </a>
            {% endfor %}
        </div>
    {% endif %}
</div>
