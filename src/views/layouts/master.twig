<!DOCTYPE html>
{#
  لمح (Lamh) — Master Layout
  ألوان الهوية (أخضر زمردي) والخط ثابتة في src/assets/styles/base/_tokens.scss كمتغيرات CSS —
  وليست إعدادات عبر بوابة الشركاء (تبسيطًا وتفاديًا لصيغ twilight.json غير الموثّقة رسميًا).
  يوفر الملف hooks القياسية + blocks القياسية (styles/head/content/script) التي تمتدّ منها كل
  صفحات src/views/pages/*.
#}
<html lang="{{ store.language|default('ar') }}" dir="{{ store.direction|default('rtl') }}" class="no-js">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="#0E7C6B">

    {% hook 'head:start' %}

    <title>{% block title %}{{ page.title|default(store.name) }}{% endblock %} | {{ store.name }}</title>
    <meta name="description" content="{% block description %}{{ page.description|default(store.description) }}{% endblock %}">
    <link rel="icon" href="{{ store.avatar|default(asset('images/theme-icon.svg')) }}">
    <link rel="canonical" href="{{ current_url|default('') }}">

    {# خطوط + أيقونات سلة #}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="stylesheet" href="{{ 'font-name'|cdn }}">
    <link rel="stylesheet" href="{{ 'sallaicons.css'|cdn }}">

    {% hook 'head' %}

    <link rel="stylesheet" href="{{ 'app.css'|asset }}">
    {% block styles %}{% endblock %}

    {% hook 'head:end' %}
</head>
<body class="lamh-theme flex min-h-screen flex-col bg-white text-neutral-900 antialiased{% if theme.settings.get('topnav_is_dark') %} has-dark-topbar{% endif %}">

{% hook 'body:start' %}

<a href="#main-content" class="skip-to-content">{{ trans('common.skip_to_content')|default('تخطَّ إلى المحتوى') }}</a>

<header class="site-header{% if theme.settings.get('sticky_header') %} is-sticky{% endif %}">
    {% hook 'header:start' %}
    {% include 'components/header/top-bar' %}
    {% include 'components/header/main-header' %}
    {% include 'components/header/main-menu' %}
    {% hook 'header:end' %}
</header>

<main id="main-content" class="flex-1 w-full{% if is_page('product.single') %} pb-24 lg:pb-0{% endif %}">
    {% block content %}{% endblock %}
</main>

<footer class="site-footer{% if theme.settings.get('footer_is_dark') %} is-dark{% endif %} mt-16">
    {% hook 'footer:start' %}
    {% include 'components/footer/main-footer' %}
    {% include 'components/footer/bottom-bar' %}
    {% hook 'footer:end' %}
</footer>

{# مكوّنات سلة الجاهزة (تسجيل الدخول، البحث، السلة، العروض) — من حزمة @salla.sa/twilight-components،
   راجع أسماء العناصر مقابل الإصدار المثبَّت لديك عند أول تشغيل محلي #}
<salla-login-modal></salla-login-modal>
<salla-quick-search></salla-quick-search>
<salla-cart-summary class="hidden"></salla-cart-summary>
{% if settings.offers_enabled|default(false) %}<salla-offer-modal></salla-offer-modal>{% endif %}

{% hook 'body:end' %}

<script src="{{ 'twilight.js'|cdn }}" defer></script>
<script src="{{ 'app.js'|asset }}" defer></script>
{% block script %}{% endblock %}

</body>
</html>
