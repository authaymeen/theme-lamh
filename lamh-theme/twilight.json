{
  "version": "1.0.0",
  "theme_name": "لمح | Lamh",
  "repo_url": "https://github.com/YOUR_GITHUB_ACCOUNT/theme-lamh",
  "support_url": "mailto:admin@automataiqksa.com",

  "settings": [
    {
      "type": "string",
      "format": "color",
      "id": "theme_accent_color",
      "label": "لون التمييز الرئيسي",
      "value": "#0E7C6B"
    },
    {
      "type": "string",
      "format": "select",
      "id": "theme_font",
      "label": "خط المتجر",
      "options": ["IBM Plex Sans Arabic", "Tajawal", "Cairo"],
      "value": "IBM Plex Sans Arabic"
    },
    {
      "type": "boolean",
      "format": "switch",
      "id": "sticky_header",
      "label": "تثبيت الهيدر عند التمرير",
      "selected": true
    },
    {
      "type": "boolean",
      "format": "switch",
      "id": "topnav_is_dark",
      "label": "شريط علوي داكن",
      "selected": false
    },
    {
      "type": "boolean",
      "format": "switch",
      "id": "footer_is_dark",
      "label": "فوتر داكن",
      "selected": true
    },
    {
      "type": "string",
      "format": "select",
      "id": "product_image_fit",
      "label": "طريقة عرض صور المنتجات",
      "options": ["cover", "contain"],
      "value": "cover"
    },
    {
      "type": "boolean",
      "format": "switch",
      "id": "show_breadcrumb",
      "label": "إظهار مسار التصفح (Breadcrumb)",
      "selected": true
    },
    {
      "type": "boolean",
      "format": "switch",
      "id": "show_quick_add",
      "label": "زر إضافة سريعة للسلة داخل شبكة المنتجات",
      "selected": true
    },
    {
      "type": "boolean",
      "format": "switch",
      "id": "show_ratings",
      "label": "إظهار تقييمات المنتج",
      "selected": true
    },
    {
      "type": "string",
      "format": "textarea",
      "id": "announcement_bar_text",
      "label": "نص الشريط العلوي (شحن مجاني / عرض حالي)",
      "value": "شحن مجاني للطلبات فوق 200 ر.س"
    },
    {
      "type": "string",
      "format": "text",
      "id": "whatsapp_number",
      "label": "رقم واتساب للدعم (يظهر كزر عائم)",
      "value": ""
    }
  ],

  "features": [
    "mega-menu",
    "fonts",
    "color",
    "breadcrumb",
    "filters",
    "component-featured-products",
    "component-products-slider",
    "component-photos-slider",
    "component-testimonials",
    "component-random-testimonials",
    "component-store-features",
    "component-square-photos",
    "component-fixed-banner",
    "component-youtube"
  ],

  "components": [
    {
      "name": "hero-banner",
      "title": "بانر رئيسي (لمح)",
      "icon": "sicon-image-carousel",
      "path": "home.hero-banner",
      "fields": [
        {
          "id": "slides",
          "type": "collection",
          "format": "collection",
          "label": "الشرائح",
          "required": true,
          "minLength": 1,
          "maxLength": 5,
          "fields": [
            { "id": "image", "type": "string", "format": "image", "label": "صورة الشريحة (يفضّل 1920×800)", "required": true },
            { "id": "title", "type": "string", "format": "text", "label": "العنوان", "required": false },
            { "id": "subtitle", "type": "string", "format": "text", "label": "العنوان الفرعي", "required": false },
            { "id": "button_text", "type": "string", "format": "text", "label": "نص الزر", "required": false },
            { "id": "button_link", "type": "string", "format": "text", "label": "رابط الزر", "required": false }
          ]
        }
      ]
    },
    {
      "name": "categories-grid",
      "title": "شبكة تصنيفات (لمح)",
      "icon": "sicon-grid",
      "path": "home.categories-grid",
      "fields": [
        { "id": "title", "type": "string", "format": "text", "label": "عنوان القسم", "required": false, "value": "تسوّق حسب التصنيف" },
        {
          "id": "categories",
          "type": "collection",
          "format": "collection",
          "label": "التصنيفات",
          "required": true,
          "minLength": 2,
          "maxLength": 8,
          "fields": [
            { "id": "image", "type": "string", "format": "image", "label": "صورة التصنيف (مربّعة)", "required": true },
            { "id": "title", "type": "string", "format": "text", "label": "اسم التصنيف", "required": true },
            { "id": "link", "type": "string", "format": "text", "label": "رابط التصنيف", "required": true }
          ]
        }
      ]
    },
    {
      "name": "value-props",
      "title": "مزايا المتجر (لمح)",
      "icon": "sicon-badge-discount",
      "path": "home.value-props",
      "fields": [
        {
          "id": "items",
          "type": "collection",
          "format": "collection",
          "label": "المزايا",
          "required": true,
          "minLength": 2,
          "maxLength": 4,
          "fields": [
            { "id": "icon", "type": "string", "format": "text", "label": "اسم أيقونة سلة (مثال: sicon-shipping-fast)", "required": true },
            { "id": "title", "type": "string", "format": "text", "label": "العنوان", "required": true },
            { "id": "text", "type": "string", "format": "text", "label": "وصف مختصر", "required": false }
          ]
        }
      ]
    },
    {
      "name": "featured-collection",
      "title": "تشكيلة مختارة (لمح)",
      "icon": "sicon-shopping-bag",
      "path": "home.featured-collection",
      "fields": [
        { "id": "title", "type": "string", "format": "text", "label": "عنوان القسم", "required": true, "value": "تشكيلة مختارة لك" },
        { "id": "subtitle", "type": "string", "format": "text", "label": "عنوان فرعي", "required": false },
        { "id": "source", "type": "string", "format": "select", "label": "مصدر المنتجات", "options": ["latest", "best_selling", "specific_category"], "value": "latest" },
        { "id": "category", "type": "string", "format": "category", "label": "التصنيف (عند اختيار تصنيف محدد)", "required": false },
        { "id": "limit", "type": "number", "format": "text", "label": "عدد المنتجات", "value": 8 }
      ]
    }
  ]
}
