{% set banner = component('home.hero-banner') %}
{% if banner and banner.slides|default([])|length %}
<section class="hero-banner relative" aria-label="{{ trans('home.hero_banner')|default('العروض الرئيسية') }}">
    <div class="hero-slider" data-component="hero-slider">
        {% for slide in banner.slides %}
            <div class="hero-slide relative {% if not loop.first %}hidden{% endif %}" data-slide-index="{{ loop.index0 }}">
                <img src="{{ slide.image }}" alt="{{ slide.title|default(store.name) }}"
                     class="w-full h-[320px] sm:h-[420px] lg:h-[520px] object-cover"
                     loading="{{ loop.first ? 'eager' : 'lazy' }}">
                {% if slide.title or slide.subtitle or slide.button_text %}
                <div class="absolute inset-0 bg-gradient-to-t from-black/50 via-black/10 to-transparent flex items-end sm:items-center">
                    <div class="max-w-container mx-auto px-6 sm:px-10 py-10 text-white max-w-lg">
                        {% if slide.subtitle %}<p class="text-sm sm:text-base opacity-90 mb-2">{{ slide.subtitle }}</p>{% endif %}
                        {% if slide.title %}<h2 class="text-2xl sm:text-4xl font-bold mb-4">{{ slide.title }}</h2>{% endif %}
                        {% if slide.button_text and slide.button_link %}
                            <a href="{{ slide.button_link }}" class="inline-flex items-center gap-2 bg-white text-neutral-900 hover:bg-accent hover:text-white transition-colors rounded-pill px-6 py-3 text-sm font-semibold">
                                {{ slide.button_text }}
                                <i class="sicon-arrow-left rtl:rotate-180" aria-hidden="true"></i>
                            </a>
                        {% endif %}
                    </div>
                </div>
                {% endif %}
            </div>
        {% endfor %}

        {% if banner.slides|length > 1 %}
        <div class="hero-dots absolute bottom-4 start-1/2 -translate-x-1/2 flex gap-2">
            {% for slide in banner.slides %}
                <button type="button" class="w-2 h-2 rounded-full bg-white/60 data-[active]:bg-white" data-slide-dot="{{ loop.index0 }}" aria-label="{{ trans('common.slide')|default('شريحة') }} {{ loop.index }}"></button>
            {% endfor %}
        </div>
        {% endif %}
    </div>
</section>
{% endif %}
