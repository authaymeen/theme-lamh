{# props (اختياري): compact #}
<div class="product-price flex items-center gap-3 {{ compact|default(false) ? 'text-base' : 'text-2xl' }}">
    {% if product.sale_price and product.sale_price < product.price %}
        <span class="font-bold text-accent">{{ product.sale_price|currency }}</span>
        <span class="text-neutral-400 line-through {{ compact|default(false) ? 'text-sm' : 'text-lg' }}">{{ product.price|currency }}</span>
    {% else %}
        <span class="font-bold text-neutral-900">{{ product.price|currency }}</span>
    {% endif %}

    {% if store.settings.tax_included|default(false) %}
        <span class="text-xs text-neutral-400 font-normal">({{ trans('product.tax_included')|default('شامل الضريبة') }})</span>
    {% endif %}
</div>

{% if product.installments|default(false) %}
    <p class="text-xs text-neutral-500 mt-1.5">{{ trans('product.installments_from')|default('أو قسّمها بدون فوائد') }}</p>
{% endif %}
