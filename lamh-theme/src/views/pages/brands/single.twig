{% extends 'layouts/master' %}

{% block title %}{{ brand.name }}{% endblock %}

{% block content %}
    {% if theme.settings.get('show_breadcrumb') %}
        {% include 'components/header/breadcrumb' with {items: [{title: trans('common.brands')|default('الماركات'), url: page('brands')}, {title: brand.name, url: ''}]} %}
    {% endif %}

    <div class="max-w-container mx-auto px-4 py-10">
        <div class="flex items-center gap-5 mb-10">
            {% if brand.logo %}
                <div class="w-20 h-20 rounded-card border border-neutral-100 flex items-center justify-center p-3 shrink-0">
                    <img src="{{ brand.logo }}" alt="{{ brand.name }}" class="max-w-full max-h-full object-contain">
                </div>
            {% endif %}
            <div>
                <h1 class="text-2xl font-bold text-neutral-900">{{ brand.name }}</h1>
                {% if brand.description %}<p class="text-sm text-neutral-500 mt-1 max-w-xl">{{ brand.description }}</p>{% endif %}
            </div>
        </div>

        {% if brand.products|default([])|length %}
            <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4 sm:gap-6">
                {% for product in brand.products %}
                    {% include 'pages/partials/product/card' with {product: product} %}
                {% endfor %}
            </div>
        {% else %}
            {% include 'pages/partials/empty-state' with {icon: 'sicon-shopping-bag', title: trans('product.no_products_found')|default('لا توجد منتجات لهذه الماركة حاليًا')} %}
        {% endif %}
    </div>
{% endblock %}
