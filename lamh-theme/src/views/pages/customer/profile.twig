{% extends 'layouts/master' %}

{% block title %}{{ trans('customer.my_account')|default('حسابي') }}{% endblock %}

{% block content %}
<div class="max-w-container mx-auto px-4 py-10">
    <div class="grid grid-cols-1 lg:grid-cols-[240px_1fr] gap-8">
        {% include 'pages/customer/partials/sidebar' with {active: 'profile'} %}

        <div class="border border-neutral-100 rounded-card p-6">
            <h1 class="text-xl font-bold text-neutral-900 mb-6">{{ trans('customer.profile_info')|default('البيانات الشخصية') }}</h1>

            <form class="profile-form space-y-5 max-w-md" data-component="profile-form">
                <div>
                    <label class="block text-sm font-medium text-neutral-700 mb-1.5">{{ trans('customer.full_name')|default('الاسم الكامل') }}</label>
                    <input type="text" name="name" value="{{ customer.name }}" class="w-full rounded-lg border-neutral-200 focus:border-accent focus:ring-accent text-sm">
                </div>
                <div>
                    <label class="block text-sm font-medium text-neutral-700 mb-1.5">{{ trans('customer.email')|default('البريد الإلكتروني') }}</label>
                    <input type="email" name="email" value="{{ customer.email }}" class="w-full rounded-lg border-neutral-200 focus:border-accent focus:ring-accent text-sm">
                </div>
                <div>
                    <label class="block text-sm font-medium text-neutral-700 mb-1.5">{{ trans('customer.mobile')|default('رقم الجوال') }}</label>
                    <input type="tel" name="mobile" value="{{ customer.mobile }}" class="w-full rounded-lg border-neutral-200 focus:border-accent focus:ring-accent text-sm" dir="ltr">
                </div>
                <button type="submit" class="bg-accent hover:bg-accent-dark text-white rounded-pill px-6 py-3 text-sm font-semibold transition-colors">
                    {{ trans('common.save_changes')|default('حفظ التغييرات') }}
                </button>
            </form>
        </div>
    </div>
</div>
{% endblock %}
