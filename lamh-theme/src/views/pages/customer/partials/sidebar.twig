{# props: active #}
<aside class="customer-sidebar border border-neutral-100 rounded-card p-4 h-fit">
    <div class="flex items-center gap-3 p-3 mb-2 border-b border-neutral-100 pb-4">
        <span class="w-11 h-11 rounded-full bg-accent-light text-accent flex items-center justify-center font-bold">
            {{ customer.name|default('')|slice(0, 1) }}
        </span>
        <div class="min-w-0">
            <p class="font-semibold text-sm text-neutral-900 truncate">{{ customer.name }}</p>
            <p class="text-xs text-neutral-400 truncate">{{ customer.email }}</p>
        </div>
    </div>
    <nav>
        <ul class="space-y-1 text-sm">
            {% set links = [
                {key: 'profile', title: trans('customer.profile_info')|default('البيانات الشخصية'), url: page('customer.profile'), icon: 'sicon-user'},
                {key: 'orders', title: trans('customer.my_orders')|default('طلباتي'), url: page('customer.orders.index'), icon: 'sicon-box'},
                {key: 'wishlist', title: trans('common.wishlist')|default('المفضلة'), url: page('customer.wishlist'), icon: 'sicon-heart'},
                {key: 'notifications', title: trans('customer.notifications')|default('الإشعارات'), url: page('customer.notifications'), icon: 'sicon-bell'}
            ] %}
            {% for item in links %}
                <li>
                    <a href="{{ item.url }}" class="flex items-center gap-2.5 rounded-lg px-3 py-2.5 transition-colors {% if active == item.key %}bg-accent-light text-accent font-medium{% else %}text-neutral-600 hover:bg-neutral-50{% endif %}">
                        <i class="{{ item.icon }}" aria-hidden="true"></i> {{ item.title }}
                    </a>
                </li>
            {% endfor %}
            <li class="border-t border-neutral-100 mt-2 pt-2">
                <a href="{{ page('customer.logout') }}" class="flex items-center gap-2.5 rounded-lg px-3 py-2.5 text-red-500 hover:bg-red-50">
                    <i class="sicon-logout" aria-hidden="true"></i> {{ trans('customer.logout')|default('تسجيل الخروج') }}
                </a>
            </li>
        </ul>
    </nav>
</aside>
