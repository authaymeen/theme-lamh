{% extends 'layouts/master' %}

{#
  صفحة هبوط ترويجية (عرض/مناسبة) بعدّاد تنازلي — تُنشأ عادة لحملة أو تخفيضات موسمية.
#}

{% block title %}{{ page.title|default(trans('pages.landing_page')|default('عرض خاص')) }}{% endblock %}

{% block content %}
<div class="landing-page">
    <section class="relative bg-neutral-900 text-white text-center py-20 px-4">
        {% if page.banner %}
            <img src="{{ page.banner }}" alt="" class="absolute inset-0 w-full h-full object-cover opacity-40">
        {% endif %}
        <div class="relative max-w-2xl mx-auto">
            <h1 class="text-3xl sm:text-5xl font-bold mb-4">{{ page.title }}</h1>
            {% if page.subtitle %}<p class="text-lg opacity-80 mb-8">{{ page.subtitle }}</p>{% endif %}

            {% if page.ends_at %}
                <div class="countdown-timer flex justify-center gap-4" data-ends-at="{{ page.ends_at }}">
                    {% for unit in ['days', 'hours', 'minutes', 'seconds'] %}
                        <div class="bg-white/10 rounded-card px-4 py-3 min-w-[70px]">
                            <span class="block text-2xl font-bold" data-unit="{{ unit }}">00</span>
                            <span class="block text-xs opacity-70 mt-1">{{ trans('countdown.' ~ unit)|default(unit) }}</span>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    </section>

    {% if landing_products|default([])|length %}
    <section class="max-w-container mx-auto px-4 py-14">
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4 sm:gap-6">
            {% for product in landing_products %}
                {% include 'pages/partials/product/card' with {product: product} %}
            {% endfor %}
        </div>
    </section>
    {% endif %}

    {% if page.content %}
        <section class="max-w-3xl mx-auto px-4 pb-16 prose prose-neutral">{{ page.content|raw }}</section>
    {% endif %}
</div>
{% endblock %}
