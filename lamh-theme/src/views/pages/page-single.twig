{% extends 'layouts/master' %}

{#
  صفحة نصّية عامة (سياسة الخصوصية، الشروط والأحكام، من نحن...) — تُعبَّأ من لوحة تحكم سلة.
#}

{% block title %}{{ page.title }}{% endblock %}
{% block description %}{{ page.description|default(page.title) }}{% endblock %}

{% block content %}
    {% if theme.settings.get('show_breadcrumb') %}
        {% include 'components/header/breadcrumb' with {items: [{title: page.title, url: ''}]} %}
    {% endif %}

    <article class="max-w-3xl mx-auto px-4 py-12">
        <h1 class="text-2xl sm:text-3xl font-bold text-neutral-900 mb-8">{{ page.title }}</h1>
        <div class="prose prose-neutral max-w-none text-sm sm:text-base leading-relaxed text-neutral-600">
            {{ page.content|raw }}
        </div>
    </article>
{% endblock %}
